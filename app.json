{
  "expo": {
    "name": "Oripio",
    "slug": "oripio-food-delivery",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#D62400",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oripio.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D62400"
      },
      "package": "com.oripio.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D62400",
          "image": "./assets/oripio1.png",
          "imageWidth": 200
        }
      ]
    ]
  }
}